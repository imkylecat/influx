{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "jsx-a11y",
    "react",
    "react-perf"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-implied-eval": "off"
      }
    }
  ],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  }
}
