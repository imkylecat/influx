{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "paths": {
      "@api/*": ["./src/renderer/api/*"],
      "@utils/*": ["./src/renderer/utils/*"],
      "@webpack/*": ["./src/renderer/webpack/*"]
    }
  },
  "include": ["src", "scripts/*.ts"]
}
